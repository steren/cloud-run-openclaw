{
	"gateway": {
		"mode": "local",
		"trustedProxies": [
			"0.0.0.0/0"
		],
		"bind": "lan",
		"auth": {
			"password": "${OPENCLAW_GATEWAY_PASSWORD}"
		},
		"controlUi": {
			"dangerouslyDisableDeviceAuth": true,
			"allowedOrigins": [
				"*"
			],
			"enabled": true
		}
	},
	"agents": {
		"defaults": {
			"model": {
				"primary": "google/gemini-3.5-flash"
			}
		}
	},
	"plugins": {
		"entries": {
			"google": {
				"enabled": true
			}
		}
	}
}